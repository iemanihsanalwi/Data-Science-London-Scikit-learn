    "    print(f'{name}: Mean F1 = {cv_scores.mean():.4f}, Std F1 = {cv_scores.std():.4f}')\n",
    "\n",
    "# Display model comparison table\n",
    "model_comparison = pd.DataFrame.from_dict(results, orient='index', columns=['Mean F1 Score'])\n",
